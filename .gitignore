node_modules
dist
dist-ssr
*.local

# 文档（仅本地留档，不公开到仓库；含开发文档与内部安全审查报告）
docs/

# 环境变量（真实密钥绝不入库；仅 .env.example 入库）
.env
.env.*
!.env.example

# Tauri 生成物（构建时产生，不入库）
/src-tauri/target
/src-tauri/gen
/src-tauri/gen.schema.json

# 用户数据（本地优先，绝不入库）
*.db
*.sqlite
*.sqlite3
qingjian-data/

# 签名 / 密钥
*.keystore
*.p12
*.pfx
*.pem

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# WorkBuddy 项目记忆（工具数据，不入库）
.workbuddy/

# Vite/临时文件
*.timestamp-*.mjs
_tmp_*
.tmp/



# 注意：pnpm-workspace.yaml 必须入库！pnpm v11 的构建脚本审批(allowBuilds)只能写在此文件，
# 且必须随仓库提交，否则 CI(pnpm install --frozen-lockfile) 会因 [ERR_PNPM_IGNORED_BUILDS] 失败。
