# ===== 青简 环境变量示例 =====
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，绝不入库。
# 实际 AI 请求经 Tauri(Rust) 后端中转，Key 仅在本地读取，不进前端包体。

# 云端 AI（OpenAI 兼容协议）
QINGJIAN_CLOUD_API_KEY=
QINGJIAN_CLOUD_BASE_URL=https://api.openai.com/v1
QINGJIAN_CLOUD_MODEL=gpt-4o-mini

# 本地 AI（Ollama，默认本机）
QINGJIAN_LOCAL_BASE_URL=http://127.0.0.1:11434
QINGJIAN_LOCAL_MODEL=llama3
